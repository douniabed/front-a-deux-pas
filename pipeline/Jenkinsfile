pipeline {
    agent {
        label 'java-node-cypress'
    }

    options {
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    environment {
        APP_NAME = 'front-a-deux-pas'
        NEXUS_URL = 'http://nexus.local:8085'
        NEXUS_REPO = 'maven-adp-front'
        NEXUS_CREDENTIALS = credentials('nexus-credentials')
        DOCKER_IMAGE = 'douniabed/front-a-deux-pas'
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Checking out code from ${env.BRANCH_NAME} branch"
                checkout scm
            }
        }

        stage('Determine Version') {
            steps {
                script {
                    def packageJson = readJSON file: 'package.json'
                    def baseVersion = packageJson.version

                    if (env.BRANCH_NAME == 'main') {
                        // Remove -SNAPSHOT suffix for releases
                        env.APP_VERSION = baseVersion.replace('-SNAPSHOT', '') + "-${env.GIT_COMMIT.take(7)}"
                        env.IS_RELEASE = 'true'
                        env.ARTIFACT_TYPE = 'release'
                    } else {
                        // Keep -SNAPSHOT for dev branches
                        env.APP_VERSION = baseVersion
                        env.IS_RELEASE = 'false'
                        env.ARTIFACT_TYPE = 'snapshot'
                    }

                    echo "Application Version: ${env.APP_VERSION}"
                    echo "Artifact Type: ${env.ARTIFACT_TYPE}"
                    // Set build display name with version and commit ID
                    currentBuild.displayName = "#${env.BUILD_NUMBER} - ${env.APP_VERSION} (${env.GIT_COMMIT.take(7)})"
                }
            }
        }
        
        stage('Install Dependencies') {
            steps {
                echo 'Installing npm dependencies...'
                sh 'npm ci'
            }
        }

        stage('Build') {
            steps {
                echo 'Building application...'
                sh 'npm run build:ci'
            }
        }

        stage('Run E2E Tests') {
            when {
                environment name: 'ARTIFACT_TYPE', value: 'snapshot'
            }
            steps {
                script {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        echo 'Running Cypress E2E tests...'
                        sh '''
                            npm run build
                            npm start -- --host 0.0.0.0 &
                            SERVER_PID=$!

                            # Wait for server to be ready
                            timeout 120 bash -c 'until curl -f http://localhost:4200 > /dev/null 2>&1; do sleep 1; done' || true

                            # Run E2E tests
                            npx cypress run --e2e

                            # Kill the server
                            kill $SERVER_PID || true
                        '''
                    }
                }
            }
        }

        stage('Run Component Tests') {
            when {
                environment name: 'ARTIFACT_TYPE', value: 'snapshot'
            }
            steps {
                script {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        echo 'Running Cypress component tests...'
                        sh 'npx cypress run --component'
                    }
                }
            }
        }

        stage('Package Artifact') {
            steps {
                script {
                    echo 'Creating frontend-version.json file...'
                    def versionInfo = [
                        name: env.APP_NAME,
                        version: env.APP_VERSION,
                        branch: env.BRANCH_NAME,
                        commit: env.GIT_COMMIT,
                        buildUrl: env.BUILD_URL,
                        buildTime: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC')),
                        artifactType: env.ARTIFACT_TYPE
                    ]
                    writeJSON file: 'dist/front/browser/assets/frontend-version.json', json: versionInfo, pretty: 4
                    sh 'cat dist/front/browser/assets/frontend-version.json'
                }
                echo 'Creating artifact...'
                sh '''
                    tar -czf ${APP_NAME}-${APP_VERSION}.tar.gz -C dist/front/browser .
                    echo "=== Artifact size ==="
                    ls -lh ${APP_NAME}-${APP_VERSION}.tar.gz
                '''
                // Stash files needed for Docker build
                stash includes: 'dist/**/*,docker/**,.dockerignore', name: 'docker-build-files'
            }
        }

        stage('Upload to Nexus') {
            steps {
                script {
                    echo "Uploading artifact to Nexus ${env.ARTIFACT_TYPE} repository..."

                    nexusArtifactUploader(
                        nexusVersion: 'nexus3',
                        protocol: 'http',
                        nexusUrl: 'nexus.local:8085',
                        groupId: 'fr.a-deux-pas',
                        version: env.APP_VERSION,
                        repository: env.NEXUS_REPO,
                        credentialsId: 'nexus-credentials',
                        artifacts: [
                            [
                                artifactId: env.APP_NAME,
                                classifier: '',
                                file: "${env.APP_NAME}-${env.APP_VERSION}.tar.gz",
                                type: 'tar.gz'
                            ]
                        ]
                    )

                    echo "Artifact uploaded successfully to Nexus"
                }
            }
        }

        stage('Docker Build') {
            agent {
                label 'docker'
            }
            steps {
                unstash 'docker-build-files'
                script {
                    def latestTag = 'latest'
                    // Clean up all old Docker images for this repo before build
                    sh """
                        docker images ${DOCKER_IMAGE} -q | xargs -r docker rmi -f || true
                    """
                    echo "Building Docker image ${env.DOCKER_IMAGE}:${env.APP_VERSION} and ${latestTag}..."
                    sh """
                        docker build --no-cache \
                            -f docker/Dockerfile \
                            -t ${DOCKER_IMAGE}:${APP_VERSION} \
                            -t ${DOCKER_IMAGE}:${latestTag} \
                            .
                    """
                    env.DOCKER_LATEST_TAG = latestTag
                    echo "Docker image built successfully"
                }
            }
        }

        stage('Docker Push') {
            agent {
                label 'docker'
            }
            steps {
                script {
                    def latestTag = 'latest'
                    echo "Pushing Docker image to DockerHub..."
                    sh """
                        echo ${DOCKERHUB_CREDENTIALS_PSW} | docker login -u ${DOCKERHUB_CREDENTIALS_USR} --password-stdin
                        docker push ${DOCKER_IMAGE}:${APP_VERSION}
                        docker push ${DOCKER_IMAGE}:${latestTag}
                        docker logout
                    """
                    echo "Docker image pushed successfully to DockerHub"
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution completed'

            // Archive build artifact
            script {
                if (fileExists("${env.APP_NAME}-${env.APP_VERSION}.tar.gz")) {
                    archiveArtifacts artifacts: "${env.APP_NAME}-${env.APP_VERSION}.tar.gz", fingerprint: true
                    echo "Build artifact ${env.APP_NAME}-${env.APP_VERSION}.tar.gz archived"
                }
            }

            // Archive Cypress screenshots and videos
            script {
                if (fileExists('cypress/screenshots')) {
                    archiveArtifacts artifacts: 'cypress/screenshots/**/*.png', allowEmptyArchive: true, fingerprint: true
                    echo 'Cypress screenshots archived'
                }
                if (fileExists('cypress/videos')) {
                    archiveArtifacts artifacts: 'cypress/videos/**/*.mp4', allowEmptyArchive: true, fingerprint: true
                    echo 'Cypress videos archived'
                }
            }

            cleanWs(deleteDirs: true, patterns: [[pattern: 'node_modules/**', type: 'INCLUDE']])
        }
        success {
            echo "Build successful! Version ${env.APP_VERSION} has been built and uploaded."
        }
        failure {
            echo 'Build failed!'
        }
    }
}
